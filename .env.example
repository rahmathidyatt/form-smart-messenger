# Public: Cloudflare Turnstile site key, restricted to your hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only. Example origin for local development; use actual HTTPS origin in Netlify.
APP_ORIGIN=http://localhost:3000
TURNSTILE_SECRET_KEY=
# Google Apps Script WEB APP /exec URL (not /dev).
APPS_SCRIPT_URL=
# Generate separate 32+ byte secrets; do not use example strings.
APPS_SCRIPT_SECRET=
ADMIN_ACCESS_TOKEN=
